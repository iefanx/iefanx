---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/journal.css';

const posts = (await getCollection('blog')).filter(post => post.data.kind === 'research').sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || b.id.localeCompare(a.id));
const [leadPost, ...archivePosts] = posts;

/** Formats a repository publication date using the journal's stable editorial treatment. */
function formatDate(date: Date): string {
	return new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'short', timeZone: 'UTC', year: 'numeric' }).format(date);
}

/** Estimates reading time from the Markdown body committed for a journal entry. */
function readingMinutes(post: CollectionEntry<'blog'>): number {
	const words = post.body.replace(/```[\s\S]*?```/g, ' ').trim().split(/\s+/).filter(Boolean).length;
	return Math.max(1, Math.ceil(words / 220));
}
---

<!doctype html>
<html lang="en">
	<head><BaseHead title="Research — Iefan" description="Long-form field notes on security architecture, sovereign systems, embedded hardware, privacy, and applied intelligence." /></head>
	<body>
		<div class="site-shell blog-shell">
			<Header />
			<main class="journal-main" id="top">
				<section class="journal-masthead" aria-labelledby="journal-title">
					<div class="journal-mark" aria-hidden="true"><span>WR</span><small>Est. 2025</small></div>
					<div><p class="eyebrow">Research desk · Working proposals</p><h1 id="journal-title">Open questions for systems that respect their users.</h1></div>
					<p class="journal-deck">Research questions, proposed methods, and evaluation plans. These are working drafts, not peer-reviewed papers or experimentally validated results.</p>
				</section>

				<section class="lead-story" aria-labelledby="lead-story-title">
					<div class="lead-story-ledger"><p class="eyebrow">Lead proposal</p><span class="lead-number">001</span><div><time datetime={leadPost.data.pubDate.toISOString()}>{formatDate(leadPost.data.pubDate)}</time><span>{readingMinutes(leadPost)} min read</span></div></div>
					<article>
						<p class="publication-label">{leadPost.data.status}</p><p class="topic-line">{leadPost.data.topics.join(' · ')}</p>
						<h2 id="lead-story-title"><a href={`/blog/${leadPost.id}/`} data-testid="blog-lead-story-link">{leadPost.data.title}</a></h2>
						<p>{leadPost.data.description}</p>
						<a class="read-link" href={`/blog/${leadPost.id}/`} data-testid="blog-lead-read-link">Read the proposal <span aria-hidden="true">↗</span></a>
					</article>
				</section>

				<section class="journal-archive" aria-labelledby="archive-title">
					<div class="archive-intro"><p class="eyebrow">From the archive</p><h2 id="archive-title">Further investigations</h2><p>Each note begins with a concrete systems problem and follows the tradeoffs all the way down.</p><a href="/rss.xml" class="rss-link" data-testid="blog-rss-link">Follow via RSS ↗</a><a href="/research/" class="rss-link">Research proposals ↗</a></div>
					<div class="archive-grid">
						{archivePosts.map((post, index) => (
							<article class="archive-card">
								<div class="archive-card-meta"><span>{String(index + 2).padStart(2, '0')}</span><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
								<p class="publication-label">{post.data.status}</p><h3><a href={`/blog/${post.id}/`} data-testid={`blog-archive-${post.id}-link`}>{post.data.title}</a></h3>
								<p>{post.data.description}</p>
								<div class="article-topics"><span>{post.data.topics.join(' · ')}</span><span>{readingMinutes(post)} min read</span></div>
							</article>
						))}
					</div>
				</section>

				<section class="editorial-note" aria-label="Editorial approach"><p class="eyebrow">Editorial compass</p><blockquote>“The useful technical essay leaves the reader with a model they can carry into the next hard problem.”</blockquote><p>Written from implementation work, published from the repository, and kept deliberately independent of an attention-driven platform.</p></section>
			</main>
			<Footer folio="journal / 001" />
		</div>
	</body>
</html>
