---
const isJournal = Astro.url.pathname.startsWith('/blog');
---

<header class="site-header">
	<a class="brand" href="/#top" aria-label="Iefan, home" data-testid="site-header-brand-link">
		<span class="brand-mark" aria-hidden="true">i.</span>
		<span>iefan</span>
	</a>
	<p class="edition">Field notes on sovereign technology &amp; careful engineering</p>
	<nav aria-label="Primary navigation">
		<a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined} data-testid="site-header-home-link">Home</a>
		<a href="/blog" aria-current={isJournal ? 'page' : undefined} data-testid="site-header-blog-link">Journal</a>
		<a href="/#practice" data-testid="site-header-practice-link">Practice</a>
		<a href="/#contact" data-testid="site-header-contact-link">Contact</a>
	</nav>
</header>
