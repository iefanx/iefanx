---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h2>iefan.net</h2>
			<p>Security Engineer | Software & Hardware Developer | Robotics & AI Enthusiast</p>

			<h3>Expertise</h3>
			<ul>
				<li><strong>Software:</strong> Full-stack development, high-performance systems, scalable web apps</li>
				<li><strong>Embedded & Hardware:</strong> ESP32, RISC-V, PCB prototyping, low-power systems</li>
				<li><strong>Cybersecurity:</strong> Zero-trust networks, cryptographic security, penetration testing</li>
				<li><strong>Decentralized Tech:</strong> Bitcoin, Lightning Network, P2P architecture, censorship-resistant systems</li>
				<li><strong>AI & Robotics:</strong> On-device inference, federated learning, autonomous drones, real-time processing</li>
			</ul>

			<h3>Active Projects</h3>
			
			<h5>Hardware Security</h5>
			<ul>
				<li>Secure enclaves (ESP32, RISC-V) for cryptographic key storage</li>
				<li>Custom tamper-resistant PCB design & firmware hardening</li>
				<li>Encrypted bootloaders & trusted execution environments</li>
			</ul>

			<h5>Zero-Trust Networking</h5>
			<ul>
				<li>End-to-end encrypted communication for IoT & embedded systems</li>
				<li>Distributed identity solutions, secure over-the-air updates</li>
				<li>Anonymous networking using Tor & mixnets</li>
			</ul>

			<h5>Bitcoin & Decentralized Systems</h5>
			<ul>
				<li>Lightning Network-based micropayments, non-custodial wallets</li>
				<li>Smart contracts on Bitcoin, multi-sig & multiscript implementations</li>
				<li>Security audits for mining pools, privacy-focused transactions</li>
			</ul>

			<h5>Robotics & AI</h5>
			<ul>
				<li>Programmable drones with real-time AI-driven navigation</li>
				<li>Embedded AI for low-power inference & sensor fusion</li>
				<li>Swarm intelligence & decentralized coordination algorithms</li>
			</ul>

			<h5>Privacy & Security</h5>
			<ul>
				<li>Local-first AI assistants with private inference</li>
				<li>Secure provisioning pipelines for firmware deployment</li>
				<li>Encrypted firmware execution, side-channel attack prevention</li>
			</ul>

			<h3>Tech Stack</h3>
			<p>
				Rust, C++, Python, Micropython, Terraform, WebGPU, React, Next.js, LVGL, ESP-IDF, Zephyr RTOS, ROS, Tor, Kubernetes, Docker, Lightning, IPFS, ZKP
			</p>

			<h3>Principles</h3>
			<ul>
				<li><strong>Minimal Trust:</strong> No reliance on centralized services, maximum transparency</li>
				<li><strong>Sovereignty:</strong> Full user control over data, encryption by default</li>
				<li><strong>Efficiency:</strong> Optimized for low-power hardware & edge computing</li>
				<li><strong>Resilience:</strong> Systems designed for long-term durability & security</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	h5 {
		font-size: 1.1em;
		margin: 1em 0 0.5em 0;
		font-weight: 600;
	}
</style>
