---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* Base layout fixes for all browsers */
			html, body {
				width: 100%;
				overflow-x: hidden;
			}
			
			body {
				margin: 0 auto;
				text-align: center;
			}
			
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				justify-self: center;
				margin: 0 auto;
				text-align: left;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 1080px;
				max-width: calc(100% - 1em);
				margin: auto;
				padding: 0.5em;
				color: var(--text-primary);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--text-secondary);
			}
			.last-updated-on {
				font-style: italic;
			}
			.tts-controls {
				margin: 1em 0;
				display: flex;
				justify-content: center;
			}
			.tts-btn {
				display: flex;
				align-items: center;
				gap: 0.5em;
				padding: 0.75em 1.5em;
				background-color: var(--accent);
				color: white;
				border: none;
				border-radius: 6px;
				cursor: pointer;
				font-size: 0.9em;
				font-weight: 600;
				transition: all 0.2s ease;
			}
			.tts-btn:hover {
				background-color: var(--accent-dark);
				transform: translateY(-1px);
			}
			.tts-btn:active {
				transform: translateY(0);
			}
			.tts-btn:disabled {
				opacity: 0.6;
				cursor: not-allowed;
				transform: none;
			}
			.tts-player {
				background: var(--bg-secondary);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1em;
				box-shadow: var(--box-shadow);
				width: 1080px;
				max-width: calc(100% - 1em);
				margin: 0 auto;
				display: none;
				transition: all 0.3s ease;
			}
			.tts-player.active {
				display: block;
			}
			.tts-controls.playing .tts-btn {
				display: none;
			}
			.tts-player-header {
				display: flex;
				justify-content: flex-end;
				align-items: center;
				margin-bottom: 0.75em;
			}
			.tts-close {
				background: none;
				border: none;
				cursor: pointer;
				color: var(--text-secondary);
				font-size: 1.2em;
				padding: 0;
				width: 24px;
				height: 24px;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.tts-player-controls {
				display: flex;
				align-items: center;
				gap: 0.75em;
				margin-bottom: 0.75em;
			}
			.tts-play-pause {
				background: var(--accent);
				color: white;
				border: none;
				border-radius: 50%;
				width: 40px;
				height: 40px;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: background-color 0.2s ease;
			}
			.tts-play-pause:hover {
				background-color: var(--accent-dark);
			}
			.tts-progress-container {
				flex: 1;
			}
			.tts-progress-bar {
				width: 100%;
				height: 8px;
				background: var(--border-color);
				border-radius: 4px;
				overflow: hidden;
				cursor: pointer;
				border: 1px solid var(--border-color);
			}
			.tts-progress-fill {
				height: 100%;
				background: var(--accent);
				width: 0%;
				transition: width 0.1s ease;
			}
			.tts-time {
				display: flex;
				justify-content: space-between;
				font-size: 0.8em;
				color: var(--text-secondary);
				margin-top: 0.25em;
			}
			.tts-controls-row {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 12px;
				margin-top: 12px;
				flex-wrap: wrap;
			}

			.tts-speed-controls {
				display: flex;
				align-items: center;
				gap: 6px;
				font-size: 0.8em;
				flex-shrink: 0;
			}
			.tts-speed-btn {
				background: var(--bg-secondary);
				border: 1px solid var(--border-color);
				border-radius: 4px;
				padding: 0.25em 0.5em;
				cursor: pointer;
				font-size: 0.75em;
				color: var(--text-primary);
				transition: all 0.2s ease;
			}
			.tts-speed-btn:hover {
				background: var(--accent);
				color: white;
				border-color: var(--accent);
			}
			.tts-speed-btn.active {
				background: var(--accent);
				color: white;
				border-color: var(--accent);
			}

			.tts-voice-select {
				background: var(--bg-secondary);
				color: var(--text-primary);
				border: 1px solid var(--border-color);
				border-radius: 6px;
				padding: 6px 8px;
				font-size: 11px;
				cursor: pointer;
				width: 120px;
				max-width: 120px;
				min-width: 100px;
				transition: all 0.2s ease;
				flex-shrink: 1;
			}

			.tts-voice-select:hover,
			.tts-voice-select:focus {
				border-color: var(--accent);
				outline: none;
			}

			@media (max-width: 720px) {
				.tts-player {
					width: 100%;
					max-width: calc(100% - 1em);
				}
				.tts-controls-row {
					gap: 8px;
				}
				
				.tts-speed-controls {
					gap: 4px;
				}
				
				.tts-speed-btn {
					padding: 4px 8px;
					font-size: 11px;
				}
				
				.tts-voice-select {
					width: 100px;
					font-size: 10px;
					padding: 4px 6px;
				}
				
				/* Fix Safari mobile alignment issues */
				main {
					width: 100%;
					max-width: 100%;
					margin: 0 auto !important;
					padding-top: 1em;
					text-align: center;
					box-sizing: border-box;
				}
				
				.prose {
					width: 100%;
					max-width: 100%;
					margin: 0 auto !important;
					text-align: left; /* Reset text align for content */
					box-sizing: border-box;
				}
				
				.hero-image {
					width: 100%;
					max-width: 100%;
					margin: 0.5em auto; /* Center and reduce margins */
					text-align: center;
				}
				
				.hero-image img {
					width: 100%;
					max-width: 100%;
					margin: 0 auto;
					display: block;
					box-sizing: border-box;
				}
				
				/* TTS Player positioning fix for mobile */
				.tts-player {
					left: 50% !important;
					transform: translateX(-50%) !important;
					width: calc(100% - 2em) !important;
					max-width: calc(100% - 2em) !important;
				}
				
				/* Additional mobile scaling for blog posts */
				article {
					line-height: 1.5; /* More compact line height */
				}
				
				.hero-image {
					margin: 0.5em 0; /* Smaller image margins */
				}
				
				.date {
					margin: 0.5em 0; /* Tighter date spacing */
					font-size: 0.9em;
				}
				
				.last-updated-on {
					margin: 0.5em 0;
					font-size: 0.85em;
				}
			}
			
			/* Extra compact for very small screens */
			@media (max-width: 480px) {
				article {
					line-height: 1.4;
				}
				
				.tts-controls {
					margin: 0.5em 0;
				}
				
				.hero-image {
					margin: 0.3em 0;
				}
				
				.date, .last-updated-on {
					font-size: 0.8em;
					margin: 0.3em 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<div class="tts-controls">
							<button id="tts-button" class="tts-btn" aria-label="Read article aloud">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
									<polygon points="5,3 19,12 5,21"></polygon>
								</svg>
								<span>Listen to Article</span>
							</button>
							
							<!-- TTS Player Interface (Hidden by default) -->
							<div id="tts-player" class="tts-player">
								<div class="tts-player-header">
									<button id="tts-close" class="tts-close" aria-label="Close player">×</button>
								</div>
								<div class="tts-player-controls">
									<button id="tts-play-pause" class="tts-play-pause" aria-label="Play/Pause">
										<svg id="player-play-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<polygon points="5,3 19,12 5,21"></polygon>
										</svg>
										<svg id="player-pause-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
											<rect x="6" y="4" width="4" height="16"></rect>
											<rect x="14" y="4" width="4" height="16"></rect>
										</svg>
									</button>
									<div class="tts-progress-container">
										<div class="tts-progress-bar" id="tts-progress-bar">
											<div class="tts-progress-fill" id="tts-progress-fill"></div>
										</div>
										<div class="tts-time">
											<span id="tts-current-time">0:00</span>
											<span id="tts-total-time">0:00</span>
										</div>
									</div>
								</div>
								<div class="tts-controls-row">
									<div class="tts-speed-controls">
										<button class="tts-speed-btn" data-speed="0.5">0.5x</button>
										<button class="tts-speed-btn active" data-speed="1">1x</button>
										<button class="tts-speed-btn" data-speed="1.25">1.25x</button>
										<button class="tts-speed-btn" data-speed="1.5">1.5x</button>
										<button class="tts-speed-btn" data-speed="2">2x</button>
									</div>
									<select id="tts-voice-select" class="tts-voice-select" aria-label="Select voice">
										<option value="">Loading voices...</option>
									</select>
								</div>
							</div>
						</div>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
	</body>
</html>

<script>
	// Enhanced Text-to-Speech functionality
	let speechSynthesis = window.speechSynthesis;
	let currentUtterance: SpeechSynthesisUtterance | null = null;
	let availableVoices: SpeechSynthesisVoice[] = [];
	let selectedVoice: SpeechSynthesisVoice | null = null;
	let isPlaying = false;
	let currentRate = 1.0;
	let words: string[] = [];
	let currentWordIndex = 0;
	let startTime = 0;
	let progressInterval: ReturnType<typeof setInterval> | null = null;
	let totalElapsedTime = 0; // Track total elapsed time across speed changes

	// Get the best available voice for speech synthesis
	function getBestVoice(): SpeechSynthesisVoice | null {
		availableVoices = speechSynthesis.getVoices();
		
		// Detect browser for specific optimizations
		const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
		const isChrome = /chrome/i.test(navigator.userAgent);
		
		// Priority order for voice selection (best quality first)
		let voicePreferences: RegExp[];
		
		if (isSafari) {
			// Safari-specific voice preferences (better quality voices)
			voicePreferences = [
				/Samantha|Alex|Victoria|Daniel|Karen|Moira/i, // High-quality macOS voices
				/enhanced|premium|natural/i,
				/en-US.*female|en-GB.*female/i, // Female voices often clearer in Safari
				/en-US|en-GB|en-AU/i,
				/^en/i,
				/default/i
			];
		} else {
			// Chrome and other browsers
			voicePreferences = [
				/enhanced|neural|premium|natural|high.quality/i,
				/Google.*female|Microsoft.*female/i, // High-quality female voices
				/Google|Microsoft/i, // Generally better quality on other platforms
				/female/i,
				/en-US|en-GB|en-AU/i,
				/^en/i,
				/default/i
			];
		}

		// Try each preference category
		for (const preference of voicePreferences) {
			const matchedVoice = availableVoices.find(voice => 
				preference.test(voice.name) || preference.test(voice.lang)
			);
			if (matchedVoice) {
				const isGoogleVoice = matchedVoice.name.toLowerCase().includes('google');
				console.log(`Selected voice for ${isSafari ? 'Safari' : 'Browser'}:`, matchedVoice.name, '(' + matchedVoice.lang + ')');
				if (isGoogleVoice) {
					console.log('⚠️ Google voice detected - will use restart instead of pause/resume for better reliability');
				}
				return matchedVoice;
			}
		}

		// Fallback to first available voice or null
		const fallback = availableVoices.length > 0 ? availableVoices[0] : null;
		if (fallback) {
			console.log('Using fallback voice:', fallback.name, '(' + fallback.lang + ')');
		}
		return fallback;
	}

	// Populate voice selector with available voices
	function populateVoiceSelector(voiceSelect: HTMLSelectElement) {
		if (!voiceSelect) return;
		
		availableVoices = speechSynthesis.getVoices();
		voiceSelect.innerHTML = '';
		
		// Add default option
		const defaultOption = document.createElement('option');
		defaultOption.value = '';
		defaultOption.textContent = 'Default Voice';
		voiceSelect.appendChild(defaultOption);
		
		// Filter and sort voices for better organization
		const englishVoices = availableVoices.filter(voice => 
			voice.lang.startsWith('en')
		).sort((a, b) => {
			// Prioritize enhanced/premium voices
			const aIsEnhanced = /enhanced|neural|premium|natural/i.test(a.name);
			const bIsEnhanced = /enhanced|neural|premium|natural/i.test(b.name);
			
			if (aIsEnhanced && !bIsEnhanced) return -1;
			if (!aIsEnhanced && bIsEnhanced) return 1;
			
			return a.name.localeCompare(b.name);
		});
		
		// Add English voices first
		englishVoices.forEach(voice => {
			const option = document.createElement('option');
			option.value = voice.name;
			const qualityTag = /enhanced|neural|premium|natural/i.test(voice.name) ? ' (HD)' : '';
			option.textContent = `${voice.name}${qualityTag} (${voice.lang})`;
			voiceSelect.appendChild(option);
		});
		
		// Add other voices
		const otherVoices = availableVoices.filter(voice => 
			!voice.lang.startsWith('en')
		).sort((a, b) => a.name.localeCompare(b.name));
		
		if (otherVoices.length > 0) {
			const separator = document.createElement('option');
			separator.disabled = true;
			separator.textContent = '─── Other Languages ───';
			voiceSelect.appendChild(separator);
			
			otherVoices.forEach(voice => {
				const option = document.createElement('option');
				option.value = voice.name;
				option.textContent = `${voice.name} (${voice.lang})`;
				voiceSelect.appendChild(option);
			});
		}
		
		// Select the best voice by default
		if (selectedVoice) {
			voiceSelect.value = selectedVoice.name;
		}
	}

	function initTTS() {
		const ttsButton = document.getElementById('tts-button');
		const player = document.getElementById('tts-player');
		const playPauseBtn = document.getElementById('tts-play-pause');
		const closeBtn = document.getElementById('tts-close');
		const progressBar = document.getElementById('tts-progress-bar');
		const progressFill = document.getElementById('tts-progress-fill');
		const currentTimeEl = document.getElementById('tts-current-time');
		const totalTimeEl = document.getElementById('tts-total-time');
		const playerPlayIcon = document.getElementById('player-play-icon');
		const playerPauseIcon = document.getElementById('player-pause-icon');
		const speedButtons = document.querySelectorAll('.tts-speed-btn');
		const voiceSelect = document.getElementById('tts-voice-select') as HTMLSelectElement;

		if (!ttsButton || !player || !speechSynthesis) return;

		// Check if speech synthesis is supported
		if (!('speechSynthesis' in window)) {
			ttsButton.style.display = 'none';
			return;
		}

		// Initialize voice selection (voices may load asynchronously)
		if (speechSynthesis.getVoices().length === 0) {
			speechSynthesis.addEventListener('voiceschanged', () => {
				selectedVoice = getBestVoice();
				if (voiceSelect) {
					populateVoiceSelector(voiceSelect);
				}
			});
		} else {
			selectedVoice = getBestVoice();
			if (voiceSelect) {
				populateVoiceSelector(voiceSelect);
			}
		}

		// Update total time based on current speed
		function updateTotalTime() {
			if (words.length === 0) return;
			
			// Calculate remaining words from current position
			const remainingWords = words.length - currentWordIndex;
			
			// Estimate time for remaining words (150 WPM base rate adjusted for current speed)
			const estimatedMinutes = (remainingWords / 150) / currentRate;
			const minutes = Math.floor(estimatedMinutes);
			const seconds = Math.floor((estimatedMinutes - minutes) * 60);
			
			if (totalTimeEl) {
				totalTimeEl.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
			}
		}

		// Initialize words array
		function initializeWords() {
			const articleContent = document.querySelector('.prose');
			if (!articleContent) return;

			const contentToRead = articleContent.cloneNode(true);
			if (contentToRead instanceof Element) {
				const titleSection = contentToRead.querySelector('.title');
				if (titleSection) titleSection.remove();
			}

			const textContent = contentToRead.textContent || '';
			words = textContent.split(/\s+/).filter(word => word.trim() !== '');
			
			// Reset to beginning and update total time display
			currentWordIndex = 0;
			updateTotalTime();
		}

		// Main button click handler
		ttsButton.addEventListener('click', function() {
			initializeWords();
			if (words.length === 0) return;
			
			// Reset elapsed time for fresh start
			totalElapsedTime = 0;
			
			// Hide button and show player
			ttsButton.style.display = 'none';
			player?.classList.add('active');
			startSpeech();
		});

		// Player controls
		playPauseBtn?.addEventListener('click', function() {
			if (isPlaying) {
				pauseSpeech();
			} else {
				// Always try to resume first, but with fallback to restart
				resumeSpeech();
			}
		});

		closeBtn?.addEventListener('click', function() {
			stopSpeech();
			player?.classList.remove('active');
			// Show the listen button again
			ttsButton.style.display = 'flex';
		});

		// Speed controls
		speedButtons.forEach(btn => {
			btn.addEventListener('click', function() {
				speedButtons.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');
				const newRate = parseFloat((btn as HTMLElement).dataset.speed || '1');
				
				// Update the rate first
				currentRate = newRate;
				
				// Update total time display immediately
				updateTotalTime();
				
				// If currently playing, restart with new speed from current position
				if (currentUtterance && isPlaying) {
					const wasPlaying = isPlaying;
					
					// Add current session time to total elapsed time before restarting
					const currentSessionTime = (Date.now() - startTime) / 1000;
					totalElapsedTime += currentSessionTime;
					
					stopProgressTracking(); // Stop current tracking
					speechSynthesis.cancel(); // Stop current speech
					
					if (wasPlaying) {
						// Restart from current position with new speed
						setTimeout(() => {
							startSpeech();
						}, 100);
					}
				}
			});
		});

		// Progress bar click
		progressBar?.addEventListener('click', function(e) {
			const rect = progressBar.getBoundingClientRect();
			const clickX = e.clientX - rect.left;
			const percentage = clickX / rect.width;
			const targetWordIndex = Math.floor(percentage * words.length);
			
			if (targetWordIndex >= 0 && targetWordIndex < words.length) {
				currentWordIndex = targetWordIndex;
				if (isPlaying) {
					stopSpeech();
					setTimeout(() => startSpeech(), 100);
				}
				updateProgress();
			}
		});

		// Voice selection
		if (voiceSelect) {
			voiceSelect.addEventListener('change', function() {
				const selectedVoiceName = voiceSelect.value;
				if (selectedVoiceName) {
					selectedVoice = availableVoices.find(voice => voice.name === selectedVoiceName) || null;
				} else {
					selectedVoice = getBestVoice(); // Reset to best voice
				}
				
				// Log the voice change
				if (selectedVoice) {
					const isGoogleVoice = selectedVoice.name.toLowerCase().includes('google');
					console.log('Voice changed to:', selectedVoice.name);
					if (isGoogleVoice) {
						console.log('⚠️ Google voice selected - will use restart method for pause/play');
					}
				}
				
				// If currently playing, restart with new voice
				if (currentUtterance && isPlaying) {
					const wasPlaying = isPlaying;
					
					// Add current session time to total elapsed time before restarting
					const currentSessionTime = (Date.now() - startTime) / 1000;
					totalElapsedTime += currentSessionTime;
					
					stopProgressTracking(); // Stop current tracking
					speechSynthesis.cancel(); // Stop current speech
					
					if (wasPlaying) {
						// Restart from current position with new voice
						setTimeout(() => {
							startSpeech();
						}, 100);
					}
				}
			});
		}

		function startSpeech() {
			if (currentWordIndex >= words.length) {
				currentWordIndex = 0;
			}

			const textToSpeak = words.slice(currentWordIndex).join(' ');
			if (!textToSpeak.trim()) return;

			currentUtterance = new SpeechSynthesisUtterance(textToSpeak);
			
			// Apply enhanced voice settings for better quality
			if (selectedVoice) {
				currentUtterance.voice = selectedVoice;
			}
			
			// Browser-specific optimizations
			const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
			const isGoogleVoice = selectedVoice?.name.toLowerCase().includes('google') || false;
			
			// Optimized audio settings for better quality
			currentUtterance.rate = currentRate;
			
			if (isSafari) {
				// Safari-specific optimizations
				currentUtterance.pitch = 1.1; // Slightly higher pitch for Safari clarity
				currentUtterance.volume = 0.9; // Slightly lower volume to reduce distortion
			} else if (isGoogleVoice) {
				// Google voices optimization (common in Chrome)
				currentUtterance.pitch = 1.0;
				currentUtterance.volume = 0.95; // Slightly lower to prevent clipping
			} else {
				// Chrome and other browsers
				currentUtterance.pitch = 1.0; // Neutral pitch for natural sound
				currentUtterance.volume = 1.0; // Full volume
			}
			
			// Enhanced text preprocessing for better pronunciation
			let processedText = textToSpeak
				// Fix common pronunciation issues
				.replace(/\b(\d+)\s*%/g, '$1 percent')
				.replace(/\b(\d+)\s*\$/g, '$1 dollars')
				.replace(/\b(\d+)\s*&/g, '$1 and')
				.replace(/\b(vs\.?|v\.?)\b/gi, 'versus')
				.replace(/\b(etc\.?)\b/gi, 'etcetera')
				.replace(/\b(e\.g\.?)\b/gi, 'for example')
				.replace(/\b(i\.e\.?)\b/gi, 'that is')
				.replace(/\b(w\/)\b/gi, 'with')
				.replace(/\b(w\/o)\b/gi, 'without')
				// Add natural pauses after punctuation
				.replace(/\./g, '. ')
				.replace(/,/g, ', ')
				.replace(/;/g, '; ')
				.replace(/:/g, ': ')
				.replace(/\?/g, '? ')
				.replace(/!/g, '! ')
				// Handle line breaks and paragraphs with longer pauses
				.replace(/\n\s*\n/g, '. . ')
				.replace(/\n/g, '. ')
				// Clean up extra spaces
				.replace(/\s+/g, ' ')
				.trim();
			
			currentUtterance.text = processedText;

			// Speech event handlers
			currentUtterance.onstart = function() {
				isPlaying = true;
				startTime = Date.now();
				updatePlayerUI(true);
				startProgressTracking();
			};

			currentUtterance.onerror = function(event) {
				console.log('Speech error:', event.error);
				// Handle common Google voice errors
				if (event.error === 'interrupted' || event.error === 'canceled') {
					// These are normal when pausing/stopping
					return;
				}
				
				// For other errors, try to restart
				if (isPlaying) {
					setTimeout(() => {
						console.log('Attempting to restart after error...');
						startSpeech();
					}, 500);
				}
			};

			currentUtterance.onend = function() {
				isPlaying = false;
				updatePlayerUI(false);
				stopProgressTracking();
				currentWordIndex = 0;
				updateProgress();
				// Auto-close player and show button when finished
				setTimeout(() => {
					player?.classList.remove('active');
					if (ttsButton) ttsButton.style.display = 'flex';
				}, 1000);
			};

			currentUtterance.onerror = function() {
				isPlaying = false;
				updatePlayerUI(false);
				stopProgressTracking();
			};

			// Start speaking
			speechSynthesis.speak(currentUtterance);
		}

		function pauseSpeech() {
			if (speechSynthesis.speaking) {
				// Store the current time when pausing
				if (isPlaying && startTime > 0) {
					const currentSessionTime = (Date.now() - startTime) / 1000;
					totalElapsedTime += currentSessionTime;
				}
				
				// For Google voices, we'll always restart instead of pause/resume
				// because they don't handle pause/resume reliably
				speechSynthesis.cancel(); // Use cancel instead of pause for better reliability
				isPlaying = false;
				updatePlayerUI(false);
				stopProgressTracking();
			}
		}

		function resumeSpeech() {
			// Check if we have a Google voice
			const isGoogleVoice = selectedVoice?.name.toLowerCase().includes('google') || false;
			
			if (isGoogleVoice) {
				// Google voices: always restart, never try to resume
				console.log('Google voice detected, restarting instead of resuming...');
				startSpeech();
				return;
			}
			
			// For non-Google voices, try normal pause/resume
			if (speechSynthesis.paused && currentUtterance) {
				try {
					speechSynthesis.resume();
					
					// Verify if resume worked
					setTimeout(() => {
						if (!speechSynthesis.speaking) {
							// Resume failed, restart from current position
							console.log('Resume failed, restarting speech...');
							startSpeech();
						} else {
							// Resume successful
							isPlaying = true;
							updatePlayerUI(true);
							startTime = Date.now(); // Reset start time for current session
							startProgressTracking();
						}
					}, 100);
				} catch (error) {
					console.log('Resume error, restarting:', error);
					startSpeech();
				}
			} else {
				// Not paused or no utterance, restart from current position
				startSpeech();
			}
		}

		function stopSpeech() {
			if (speechSynthesis.speaking || speechSynthesis.paused) {
				speechSynthesis.cancel();
			}
			isPlaying = false;
			updatePlayerUI(false);
			stopProgressTracking();
			currentWordIndex = 0;
			totalElapsedTime = 0;
			updateProgress();
		}

		function updatePlayerUI(playing: boolean) {
			if (playerPlayIcon && playerPauseIcon) {
				if (playing) {
					playerPlayIcon.style.display = 'none';
					playerPauseIcon.style.display = 'block';
				} else {
					playerPlayIcon.style.display = 'block';
					playerPauseIcon.style.display = 'none';
				}
			}
		}

		let progressStartWordIndex = 0;
		
		function startProgressTracking() {
			progressStartWordIndex = currentWordIndex; // Remember where we started
			progressInterval = setInterval(() => {
				if (isPlaying) {
					// Calculate progress based on time elapsed and current speed
					const timeElapsed = (Date.now() - startTime) / 1000;
					const wordsPerSecond = (150 / 60) * currentRate; // Adjust for current speed
					const estimatedWordsSpoken = timeElapsed * wordsPerSecond;
					
					// Calculate new position from where we started speaking
					const newWordIndex = Math.min(
						progressStartWordIndex + Math.floor(estimatedWordsSpoken),
						words.length - 1
					);
					
					// Only move forward, never backward
					if (newWordIndex > currentWordIndex) {
						currentWordIndex = newWordIndex;
					}
					
					updateProgress();
					updateTimeDisplay();
					updateTotalTime(); // Update remaining time
				}
			}, 300);
		}

		function stopProgressTracking() {
			if (progressInterval) {
				clearInterval(progressInterval);
				progressInterval = null;
			}
		}

		function updateProgress() {
			if (progressFill && words.length > 0) {
				const percentage = (currentWordIndex / words.length) * 100;
				progressFill.style.width = `${percentage}%`;
			}
		}

		function updateTimeDisplay() {
			if (currentTimeEl) {
				// Calculate current session time
				const currentSessionTime = (Date.now() - startTime) / 1000;
				// Add to total elapsed time from previous sessions
				const totalTime = totalElapsedTime + currentSessionTime;
				
				const minutes = Math.floor(totalTime / 60);
				const seconds = Math.floor(totalTime % 60);
				currentTimeEl.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
			}
		}



		// Handle page visibility change
		document.addEventListener('visibilitychange', function() {
			if (document.hidden && isPlaying) {
				pauseSpeech();
			}
		});

		// Handle page unload
		window.addEventListener('beforeunload', function() {
			if (isPlaying) {
				stopSpeech();
			}
		});
	}

	// Initialize when DOM is loaded
	document.addEventListener('DOMContentLoaded', initTTS);
</script>
