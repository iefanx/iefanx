---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/journal.css';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props extends CollectionEntry<'blog'>['data'] {
	postId: string;
	headings: Heading[];
	relatedPosts: CollectionEntry<'blog'>[];
	readingMinutes: number;
}

const { title, description, pubDate, updatedDate, heroImage, topics, postId, headings, relatedPosts, readingMinutes, kind, status } = Astro.props;
const ledgerHeadings = headings.filter((heading) => heading.depth === 2);

/** Formats committed publication dates consistently across article metadata and related reading. */
function formatDate(date: Date): string {
	return new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'short', timeZone: 'UTC', year: 'numeric' }).format(date);
}

/** Estimates a related post's reading time from its committed Markdown body. */
function relatedReadingMinutes(post: CollectionEntry<'blog'>): number {
	return Math.max(1, Math.ceil(post.body.trim().split(/\s+/).filter(Boolean).length / 220));
}
---

<!doctype html>
<html lang="en">
	<head><BaseHead title={`${title} — Iefan`} description={description} image={heroImage} type="article" /></head>
	<body>
		<div class="site-shell article-shell">
			<Header />
			<main class="article-main" id="top">
				<a class="back-to-journal" href="/blog" data-testid="article-back-link">← The Workbench Review</a>
				<header class="article-masthead">
					<div class="article-issue"><span>{status}</span><strong>{pubDate.getUTCFullYear()} / {postId.slice(0, 2).toUpperCase()}</strong></div>
					<div><p class="topic-line">{topics.join(' · ')}</p><h1>{title}</h1><p class="article-description">{description}</p>{kind === 'research' && <p class="draft-note">Working research proposal · Not peer reviewed or experimentally validated.</p>}</div>
					<div class="article-byline"><span>Written by Iefan</span><time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>{updatedDate && <span>Updated {formatDate(updatedDate)}</span>}<span>{readingMinutes} min read</span></div>
				</header>

				<div class="article-layout">
					<aside class="reading-ledger" aria-label="Article sections"><p class="eyebrow">Reading ledger</p><ol>{ledgerHeadings.map((heading, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol><a href="/rss.xml">RSS feed ↗</a></aside>
					<article class="prose"><slot /></article>
					<aside class="article-margin-note"><span aria-hidden="true">i.</span><p>Implementation notes from the workbench—written to make the underlying system easier to reason about.</p></aside>
				</div>

				<section class="related-reading" aria-labelledby="related-title">
					<div><p class="eyebrow">Continue reading</p><h2 id="related-title">More from the archive</h2></div>
					<div>{relatedPosts.map((post) => <article><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><span>{relatedReadingMinutes(post)} min read ↗</span></article>)}</div>
				</section>
			</main>
			<Footer folio={`journal / ${pubDate.toISOString().slice(0, 10).replaceAll('-', '.')}`} />
		</div>
	</body>
</html>
